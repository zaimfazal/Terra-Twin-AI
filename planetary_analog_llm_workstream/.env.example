# Terra Twin assistant configuration (copy to .env).
# Nothing here is required for the deterministic fallback path.
# Never add MONGODB_URI or any database credential: MongoDB is owned by the
# team's Node/Express backend, and this service only calls its read-only API.

# --- Structured data source -------------------------------------------------
# fixture | json_export | postgres | team_backend
ASSISTANT_STRUCTURED_BACKEND=fixture
ASSISTANT_ALLOW_FIXTURE_DATA=true

# Team Node/Express backend (used when ASSISTANT_STRUCTURED_BACKEND=team_backend).
TERRATWIN_BACKEND_URL=http://localhost:8000
ASSISTANT_TEAM_BACKEND_TIMEOUT_S=10
ASSISTANT_TEAM_BACKEND_MAX_RETRIES=1

# Optional read-only platform export (used when backend=json_export).
# ASSISTANT_PLATFORM_EXPORT_PATH=./fixtures/export.json

# --- Inference provider -----------------------------------------------------
# ollama (local, default) | groq (optional hosted provider, server-side key).
ASSISTANT_LLM_PROVIDER=ollama

# --- Optional hosted inference (Groq) --------------------------------------
# Leave unset for local-only use. Never commit a real key; the assistant reads
# it server-side only and never returns or logs it. Groq is never required.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_S=60
# GROQ_HEALTH_TIMEOUT_S=5
# GROQ_TEMPERATURE=0.0
# GROQ_MAX_COMPLETION_TOKENS=4096
# GROQ_STRICT_SCHEMA=false

# --- Local inference --------------------------------------------------------
ASSISTANT_OLLAMA_BASE_URL=http://127.0.0.1:11434
ASSISTANT_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
ASSISTANT_OLLAMA_FALLBACK_MODEL=qwen2.5:3b-instruct-q4_K_M
ASSISTANT_OLLAMA_NUM_CTX=8192
ASSISTANT_OLLAMA_TEMPERATURE=0.0
ASSISTANT_OLLAMA_NUM_PREDICT=1200
ASSISTANT_OLLAMA_TIMEOUT_S=600
ASSISTANT_REQUIRE_MODEL=false

# --- Storage ----------------------------------------------------------------
# ASSISTANT_DB_PATH=./data/assistant.db
